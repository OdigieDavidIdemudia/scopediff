rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The public feed is authenticated-only in v1.
    // The worker writes with the Admin SDK, which bypasses these rules.
    match /programs/{programId} {
      allow read: if signedIn();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /pending/{docId} {
        allow read, write: if false;
      }
    }

    match /changes/{changeId} {
      allow read: if signedIn();
      allow write: if false;

      match /items/{itemId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /source_runs/{runId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The free-plan build writes profiles and watches from the browser and
    // processes them with a GitHub Actions cron using the Admin SDK.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      match /watches/{programId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.program_id == programId
          && request.resource.data.status == "pending"
          && request.resource.data.active == true
          && request.resource.data.platform in ["bugcrowd", "hackerone", "intigriti"]
          && request.resource.data.interval_minutes in [30, 60]
          && request.resource.data.program_url is string
          && (
            request.resource.data.program_url.matches("^https://(www\\.)?bugcrowd\\.com/.+")
            || request.resource.data.program_url.matches("^https://(www\\.)?hackerone\\.com/.+")
            || request.resource.data.program_url.matches("^https://(www\\.)?intigriti\\.com/.+")
            || request.resource.data.program_url.matches("^https://app\\.intigriti\\.com/programs/.+")
          );
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.program_id == resource.data.program_id
          && request.resource.data.program_url == resource.data.program_url
          && request.resource.data.platform == resource.data.platform
          && request.resource.data.status == resource.data.status
          && request.resource.data.interval_minutes in [30, 60];
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

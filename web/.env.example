# ScopeDiff web environment
# Copy to web/.env.local for local development.

# Leave empty to run the bundled demo dataset. Set to the worker origin for live mode.
# VITE_API_URL=http://127.0.0.1:8765
VITE_API_URL=

# Firebase Web SDK configuration. Required for production Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check is required by Firebase AI Logic. Create a reCAPTCHA v3 key for the
# Hosting domain, register its secret in Firebase Console > Security > App Check,
# then put the public site key here for production builds.
VITE_RECAPTCHA_SITE_KEY=

# Local-only debug fallback. Register the token in App Check > Apps > Manage
# debug tokens. Never ship this in a public production build.
VITE_APPCHECK_DEBUG_TOKEN=

# Local-demo convenience token for /internal/* calls. This is embedded in the
# browser bundle, so never use a production secret here.
VITE_SCOPEDIFF_INTERNAL_TOKEN=

# Local live-worker preview only. Shows a local session button when Firebase
# Auth is not configured. Never enable in production.
VITE_ALLOW_LOCAL_SESSION=0

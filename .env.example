# ScopeDiff worker environment
# Copy to .env at the repository root. The worker loads this file with python-dotenv.

# Demo mode uses the local JSON store and bundled sandbox fixtures.
SCOPEDIFF_DEMO=true
SCOPEDIFF_STORE=json

# Local data paths. Leave blank to use worker/.data/
# SCOPEDIFF_DATA_DIR=
# SCOPEDIFF_DB_PATH=
# SCOPEDIFF_RAW_DIR=
# SCOPEDIFF_DEMO_DATA=

# Public URLs and CORS. In production set PUBLIC_URL to the Hosting URL.
SCOPEDIFF_PUBLIC_URL=http://localhost:5173
SCOPEDIFF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Auth and watch scheduling. On Cloud Run use the runtime service account and
# leave ALLOW_INSECURE_AUTH off.
SCOPEDIFF_ALLOW_INSECURE_AUTH=0
SCOPEDIFF_DEBUG_UID=debug-user
SCOPEDIFF_DEFAULT_INTERVAL_MINUTES=15
SCOPEDIFF_MIN_INTERVAL_MINUTES=1

# Protects /internal/* endpoints. Required in production; optional locally.
SCOPEDIFF_INTERNAL_TOKEN=

# Slack alerts. The notifier only accepts hooks.slack.com and hooks.slack-gov.com.
SLACK_WEBHOOK_URL=
SCOPEDIFF_SLACK_MIN_SCORE=25

# HackerOne Hacker API credentials. The adapter stays disabled until both are set.
H1_API_USER=
H1_API_TOKEN=

# Production persistence. Set SCOPEDIFF_STORE=firestore and provide application
# default credentials (or GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_CLOUD_PROJECT=
SCOPEDIFF_SNAPSHOT_BUCKET=

# Test-only escape hatch. Never enable in production.
SCOPEDIFF_ALLOW_ANY_WEBHOOK=0
